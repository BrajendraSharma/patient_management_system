@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components
@using ClinicalPatientManagement.Client.Components
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="app-layout">
    <Navigation />
    
    <main role="main" class="main-content">
        <AuthorizeView>
            <Authorized>
                <div class="container-fluid">
                    @Body
                </div>
            </Authorized>
            <NotAuthorized>
                <!-- Check if the current page is public (login or index) -->
                @if (IsPublicPage())
                {
                    <!-- Show public page content -->
                    <div class="container-fluid">
                        @Body
                    </div>
                }
                else
                {
                    <!-- Block protected page access -->
                    <div class="container">
                        <div class="row justify-content-center mt-5">
                            <div class="col-md-6">
                                <div class="alert alert-warning text-center">
                                    <h4><i class="bi bi-shield-exclamation"></i> Access Denied</h4>
                                    <p>You must be logged in to access this page.</p>
                                    <a href="/login" class="btn btn-primary">Go to Login</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </NotAuthorized>
        </AuthorizeView>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool IsPublicPage()
    {
        try
        {
            // Parse the URI to get just the path
            var uri = new Uri(Navigation.Uri);
            var path = uri.AbsolutePath.ToLowerInvariant();
            
            // Remove trailing slash for consistent comparison
            if (path.EndsWith("/") && path.Length > 1)
            {
                path = path.Substring(0, path.Length - 1);
            }
            
            // Public pages: /, /login
            return path == "" || path == "/" || path == "/login";
        }
        catch
        {
            // Default to false (protect by default)
            return false;
        }
    }
}

<style>
    .app-layout {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    .main-content {
        flex: 1;
        padding: 20px 0;
    }

    #blazor-error-ui {
        background: lightyellow;
        bottom: 0;
        box-shadow: 0 -1px 2px rgba(0, 0, 0, 0.2);
        display: none;
        left: 0;
        padding: 10px 16px;
        position: fixed;
        right: 0;
        text-align: center;
        width: 100%;
        z-index: 1000;
    }

    #blazor-error-ui .dismiss {
        cursor: pointer;
        position: absolute;
        right: 3.5rem;
        top: 0.5rem;
    }

    #blazor-error-ui .dismiss:hover {
        color: #fff;
        text-decoration: underline;
    }
</style>
