@page "/appointments/create"
@page "/appointments/edit/{AppointmentId:int}"
@using ClinicalPatientManagement.Client.Models
@using ClinicalPatientManagement.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.ComponentModel.DataAnnotations
@attribute [Authorize]
@inject IAppointmentApiClient AppointmentApiClient
@inject IPatientApiClient PatientApiClient
@inject NavigationManager NavigationManager

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-8">
            <h1 class="display-5">
                <i class="bi bi-calendar-plus"></i> 
                @if (isEditMode) 
                { 
                    <span>Edit Appointment</span> 
                } 
                else 
                { 
                    <span>Schedule New Appointment</span> 
                }
            </h1>
        </div>
    </div>

    @if (errorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (successMessage != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="alert alert-info">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            Loading appointment details...
        </div>
    }
    else
    {
        <div class="card mt-4 shadow-sm">
            <div class="card-body p-4">
                <EditForm Model="model" OnValidSubmit="HandleSubmit" OnInvalidSubmit="HandleInvalidSubmit">
                    <DataAnnotationsValidator />

                    <!-- Validation Summary -->
                    <div class="mb-3">
                        <ValidationSummary class="alert alert-warning" />
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="patientId" class="form-label">
                                Patient <span class="text-danger">*</span>
                            </label>
                            <InputSelect 
                                id="patientId" 
                                class="form-select form-select-lg" 
                                @bind-value="model!.PatientId">
                                <option value="0">-- Select Patient --</option>
                                @if (patients != null)
                                {
                                    @foreach (var patient in patients)
                                    {
                                        <option value="@patient.Id">@patient.FullName (@patient.Phone)</option>
                                    }
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => model!.PatientId)" class="d-block text-danger small mt-1" />
                        </div>

                        <div class="col-md-6">
                            <label for="appointmentDate" class="form-label">
                                Date & Time <span class="text-danger">*</span>
                            </label>
                            <input type="datetime-local" 
                                   id="appointmentDate" 
                                   class="form-control form-control-lg" 
                                   @bind="model!.AppointmentDate" />
                            <ValidationMessage For="@(() => model!.AppointmentDate)" class="d-block text-danger small mt-1" />
                            @if (conflictMessage != null)
                            {
                                <small class="d-block text-warning mt-2">
                                    <i class="bi bi-exclamation-triangle"></i> @conflictMessage
                                </small>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="status" class="form-label">
                                Status <span class="text-danger">*</span>
                            </label>
                            <InputSelect 
                                id="status" 
                                class="form-select form-select-lg" 
                                @bind-value="model!.Status">
                                <option value="">-- Select Status --</option>
                                <option value="Scheduled">Scheduled</option>
                                <option value="Completed">Completed</option>
                                <option value="Cancelled">Cancelled</option>
                                <option value="No-Show">No-Show</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => model!.Status)" class="d-block text-danger small mt-1" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label for="notes" class="form-label">Notes (Optional)</label>
                            <InputTextArea 
                                id="notes" 
                                class="form-control form-control-lg" 
                                rows="4" 
                                placeholder="Add any notes about this appointment..."
                                @bind-value="model!.Notes" />
                            <ValidationMessage For="@(() => model!.Notes)" class="d-block text-danger small mt-1" />
                            <small class="form-text text-muted">Max 1000 characters</small>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-md-12">
                            <button type="submit" class="btn btn-success btn-lg me-2" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Processing...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check-circle"></i> 
                                    @if (isEditMode) 
                                    { 
                                        <span>Update Appointment</span> 
                                    } 
                                    else 
                                    { 
                                        <span>Schedule Appointment</span> 
                                    }
                                }
                            </button>
                            <a href="/appointments" class="btn btn-secondary btn-lg">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int? AppointmentId { get; set; }

    private CreateAppointmentModel? model;
    private AppointmentModel? existingAppointment;
    private IEnumerable<PatientModel>? patients;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool isEditMode = false;
    private string? errorMessage;
    private string? successMessage;
    private string? conflictMessage;
    private EditContext? editContext;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            isEditMode = AppointmentId.HasValue && AppointmentId > 0;

            // Load patients
            patients = await PatientApiClient.GetAllAsync();

            if (isEditMode && AppointmentId.HasValue)
            {
                existingAppointment = await AppointmentApiClient.GetByIdAsync(AppointmentId.Value);
                if (existingAppointment != null)
                {
                    model = new CreateAppointmentModel
                    {
                        PatientId = existingAppointment.PatientId,
                        AppointmentDate = existingAppointment.AppointmentDate,
                        Status = existingAppointment.Status,
                        Notes = existingAppointment.Notes
                    };
                }
                else
                {
                    errorMessage = "Appointment not found.";
                    await Task.Delay(2000);
                    NavigationManager.NavigateTo("/appointments");
                }
            }
            else
            {
                model = new CreateAppointmentModel { AppointmentDate = DateTime.Now.AddDays(1).Date.AddHours(10) };
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading appointment: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override void OnParametersSet()
    {
        if (editContext == null && model != null)
        {
            editContext = new EditContext(model);
        }
    }

    private async Task CheckConflict()
    {
        if (model?.PatientId > 0 && model.AppointmentDate > DateTime.Now)
        {
            try
            {
                var result = await AppointmentApiClient.CheckConflictAsync(model.PatientId, model.AppointmentDate);
                conflictMessage = result.HasConflict ? result.Message : null;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error checking conflict: {ex.Message}");
            }
        }
    }

    private async Task HandleSubmit()
    {
        if (model == null || editContext == null)
            return;

        try
        {
            isSubmitting = true;
            errorMessage = null;
            successMessage = null;

            if (isEditMode && existingAppointment != null)
            {
                var updateModel = new UpdateAppointmentModel
                {
                    PatientId = model.PatientId,
                    AppointmentDate = model.AppointmentDate,
                    Status = model.Status,
                    Notes = model.Notes
                };
                
                await AppointmentApiClient.UpdateAsync(existingAppointment.Id, updateModel);
                successMessage = "Appointment updated successfully!";
            }
            else
            {
                await AppointmentApiClient.CreateAsync(model);
                successMessage = "Appointment scheduled successfully!";
            }

            await Task.Delay(1500);
            NavigationManager.NavigateTo("/appointments");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving appointment: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void HandleInvalidSubmit()
    {
        errorMessage = "Please fix the validation errors above before submitting.";
    }
}
