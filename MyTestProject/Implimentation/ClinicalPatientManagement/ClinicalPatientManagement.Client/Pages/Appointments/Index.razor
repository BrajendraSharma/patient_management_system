@page "/appointments"
@using ClinicalPatientManagement.Client.Models
@using ClinicalPatientManagement.Client.Services
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@inject IAppointmentApiClient AppointmentApiClient
@inject IPatientApiClient PatientApiClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="display-5">
                <i class="bi bi-calendar-event"></i> Appointments
            </h1>
        </div>
        <div class="col-md-4 text-end">
            <a href="/appointments/create" class="btn btn-primary btn-lg">
                <i class="bi bi-plus-circle"></i> New Appointment
            </a>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="alert alert-info">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            Loading appointments...
        </div>
    }
    else if (appointments == null || !appointments.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-info-circle"></i> No appointments scheduled yet.
            <a href="/appointments/create" class="alert-link">Schedule one now.</a>
        </div>
    }
    else
    {
        <div class="row mb-3">
            <div class="col-md-12">
                <div class="input-group">
                    <input type="search" class="form-control form-control-lg" placeholder="Filter by patient name..." 
                           @oninput="@((ChangeEventArgs e) => FilterAppointments(e.Value?.ToString() ?? string.Empty))">
                    <button class="btn btn-outline-secondary" type="button">
                        <i class="bi bi-search"></i> Filter
                    </button>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Patient</th>
                        <th>Date & Time</th>
                        <th>Status</th>
                        <th>Notes</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appointment in filteredAppointments ?? appointments)
                    {
                        <tr>
                            <td>
                                <strong>@GetPatientName(appointment.PatientId)</strong>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark">
                                    <i class="bi bi-calendar"></i> @appointment.FormattedDateTime
                                </span>
                            </td>
                            <td>
                                <span class="@GetStatusClass(appointment.Status)">
                                    @appointment.Status
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(appointment.Notes))
                                {
                                    <small class="text-muted">@appointment.Notes</small>
                                }
                                else
                                {
                                    <small class="text-muted text-decoration-line-through">N/A</small>
                                }
                            </td>
                            <td>
                                <small class="text-muted">@appointment.CreatedAt.ToString("dd/MM/yyyy")</small>
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="/appointments/@appointment.Id" class="btn btn-sm btn-info" title="View">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="/create-consultation/@appointment.Id" class="btn btn-sm btn-success" title="Create Consultation">
                                        <i class="bi bi-plus-circle"></i>
                                    </a>
                                    <button class="btn btn-sm btn-warning" @onclick="() => ShowEditForm(appointment)" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDelete(appointment.Id)" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3 text-muted">
            <small>Showing @(filteredAppointments?.Count() ?? appointments.Count()) of @appointments.Count() appointments</small>
        </div>
    }
</div>

@code {
    private IEnumerable<AppointmentModel>? appointments;
    private IEnumerable<AppointmentModel>? filteredAppointments;
    private Dictionary<int, string> patientNames = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            appointments = await AppointmentApiClient.GetAllAsync();
            
            // Load patient names for all appointments
            if (appointments != null)
            {
                var patients = await PatientApiClient.GetAllAsync();
                foreach (var patient in patients)
                {
                    patientNames[patient.Id] = patient.FullName;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading appointments: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void FilterAppointments(string searchTerm)
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredAppointments = null;
            return;
        }

        var lowerTerm = searchTerm.ToLower();
        filteredAppointments = appointments?.Where(a =>
            GetPatientName(a.PatientId).ToLower().Contains(lowerTerm) ||
            a.Notes.ToLower().Contains(lowerTerm) ||
            a.Status.ToLower().Contains(lowerTerm)
        ).ToList();
    }

    private string GetPatientName(int patientId)
    {
        return patientNames.TryGetValue(patientId, out var name) ? name : $"Patient #{patientId}";
    }

    private string GetStatusClass(string status)
    {
        return status switch
        {
            "Scheduled" => "badge bg-primary",
            "Completed" => "badge bg-success",
            "Cancelled" => "badge bg-danger",
            "No-Show" => "badge bg-warning",
            _ => "badge bg-secondary"
        };
    }

    private void ShowEditForm(AppointmentModel appointment)
    {
        NavigationManager.NavigateTo($"/appointments/edit/{appointment.Id}");
    }

    private async Task ConfirmDelete(int appointmentId)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this appointment?"))
        {
            try
            {
                if (await AppointmentApiClient.DeleteAsync(appointmentId))
                {
                    appointments = await AppointmentApiClient.GetAllAsync();
                    filteredAppointments = null;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting appointment: {ex.Message}");
            }
        }
    }
}
