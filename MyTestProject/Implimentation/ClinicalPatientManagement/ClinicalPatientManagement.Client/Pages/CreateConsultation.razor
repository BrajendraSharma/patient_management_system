@page "/create-consultation/{AppointmentId:int}"
@using System.Text.Json
@using ClinicalPatientManagement.Client.Models
@using ClinicalPatientManagement.Client.Services
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject IPatientApiClient PatientApiClient
@inject NavigationManager Navigation

<PageTitle>Create Consultation</PageTitle>

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2>
                <i class="bi bi-stethoscope"></i> Create Consultation
            </h2>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="alert alert-info">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            Loading appointment details...
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle"></i>
            <strong>Error:</strong> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (appointment != null && patient != null && !isLoading)
    {
        <!-- Appointment Info Card -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light border-bottom">
                <h5 class="mb-0">
                    <i class="bi bi-info-circle"></i> Appointment Information
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p class="mb-2">
                            <strong>Patient:</strong> @patient.FullName
                        </p>
                        <p class="mb-0">
                            <strong>Age:</strong> @patient.Age years
                        </p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-2">
                            <strong>Appointment Date:</strong> 
                            <span class="badge bg-primary">@appointment.AppointmentDate.ToString("dd-MMM-yyyy HH:mm")</span>
                        </p>
                        <p class="mb-0">
                            <strong>Status:</strong> 
                            <span class="badge bg-success">@appointment.Status</span>
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Consultation Form Card -->
        <div class="card shadow-sm">
            <div class="card-header bg-light border-bottom">
                <h5 class="mb-0">
                    <i class="bi bi-form-check"></i> Consultation Details
                </h5>
            </div>
            <div class="card-body">
                <EditForm Model="@consultation" OnValidSubmit="HandleSubmit" OnInvalidSubmit="HandleInvalidSubmit">
                    <DataAnnotationsValidator />

                    <!-- Validation Summary -->
                    <div class="mb-3">
                        <ValidationSummary class="alert alert-warning" />
                    </div>

                    <!-- Vital Signs Section -->
                    <div class="card mb-4 border-light">
                        <div class="card-header bg-light">
                            <h6 class="mb-0">
                                <i class="bi bi-heart-pulse"></i> Vital Signs <span class="text-danger">*</span>
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <!-- Temperature -->
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label for="temperature" class="form-label">
                                            Temperature (°C) <span class="text-danger">*</span>
                                        </label>
                                        <InputNumber 
                                            id="temperature"
                                            class="form-control form-control-lg" 
                                            @bind-value="consultation.Temperature"
                                            step="0.1"
                                            aria-label="Temperature" />
                                        <ValidationMessage For="@(() => consultation.Temperature)" class="d-block text-danger small mt-1" />
                                        <small class="form-text text-muted">Range: 30°C - 45°C</small>
                                    </div>
                                </div>

                                <!-- Blood Pressure -->
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label for="bloodPressure" class="form-label">
                                            Blood Pressure <span class="text-danger">*</span>
                                        </label>
                                        <InputText 
                                            id="bloodPressure"
                                            class="form-control form-control-lg" 
                                            @bind-value="consultation.BloodPressure"
                                            placeholder="e.g., 120/80"
                                            aria-label="Blood Pressure" />
                                        <ValidationMessage For="@(() => consultation.BloodPressure)" class="d-block text-danger small mt-1" />
                                        <small class="form-text text-muted">Format: Systolic/Diastolic</small>
                                    </div>
                                </div>

                                <!-- Pulse -->
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label for="pulse" class="form-label">
                                            Pulse (bpm) <span class="text-danger">*</span>
                                        </label>
                                        <InputNumber 
                                            id="pulse"
                                            class="form-control form-control-lg" 
                                            @bind-value="consultation.Pulse"
                                            aria-label="Pulse Rate" />
                                        <ValidationMessage For="@(() => consultation.Pulse)" class="d-block text-danger small mt-1" />
                                        <small class="form-text text-muted">Range: 40 - 200 bpm</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Complaints & Diagnosis Section -->
                    <div class="card mb-4 border-light">
                        <div class="card-header bg-light">
                            <h6 class="mb-0">
                                <i class="bi bi-file-medical"></i> Clinical Notes <span class="text-danger">*</span>
                            </h6>
                        </div>
                        <div class="card-body">
                            <!-- Complaints -->
                            <div class="mb-3">
                                <label for="complaints" class="form-label">
                                    Patient Complaints <span class="text-danger">*</span>
                                </label>
                                <InputTextArea 
                                    id="complaints"
                                    class="form-control form-control-lg" 
                                    rows="3"
                                    @bind-value="consultation.Complaints"
                                    placeholder="Describe the patient's complaints in detail..."
                                    aria-label="Patient Complaints" />
                                <ValidationMessage For="@(() => consultation.Complaints)" class="d-block text-danger small mt-1" />
                                <small class="form-text text-muted">Minimum 5 characters, Maximum 1000 characters</small>
                            </div>

                            <!-- Diagnosis -->
                            <div class="mb-3">
                                <label for="diagnosis" class="form-label">
                                    Diagnosis <span class="text-danger">*</span>
                                </label>
                                <InputTextArea 
                                    id="diagnosis"
                                    class="form-control form-control-lg" 
                                    rows="3"
                                    @bind-value="consultation.Diagnosis"
                                    placeholder="Enter the clinical diagnosis..."
                                    aria-label="Diagnosis" />
                                <ValidationMessage For="@(() => consultation.Diagnosis)" class="d-block text-danger small mt-1" />
                                <small class="form-text text-muted">Minimum 5 characters, Maximum 1000 characters</small>
                            </div>
                        </div>
                    </div>

                    <!-- Medications Section -->
                    <div class="card mb-4 border-light">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">
                                <i class="bi bi-capsule"></i> Prescribed Medications <span class="text-danger">*</span>
                            </h6>
                        </div>
                        <div class="card-body">
                            @for (int i = 0; i < medications.Count; i++)
                            {
                                int index = i;
                                var med = medications[index];
                                <div class="card mb-3 border-secondary">
                                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0">Medication @(index + 1)</h6>
                                        @if (medications.Count > 1)
                                        {
                                            <button type="button" class="btn btn-sm btn-danger" @onclick="() => RemoveMedication(index)">
                                                <i class="bi bi-trash"></i> Remove
                                            </button>
                                        }
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <!-- Medication Name -->
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label class="form-label">
                                                        Medication Name <span class="text-danger">*</span>
                                                    </label>
                                                    <InputText 
                                                        class="form-control form-control-sm"
                                                        value="@med.Name"
                                                        @onchange="@((ChangeEventArgs e) => UpdateMedication(index, nameof(med.Name), e.Value?.ToString() ?? string.Empty))"
                                                        placeholder="e.g., Paracetamol" />
                                                </div>
                                            </div>

                                            <!-- Dosage -->
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label class="form-label">
                                                        Dosage <span class="text-danger">*</span>
                                                    </label>
                                                    <InputText 
                                                        class="form-control form-control-sm"
                                                        value="@med.Dosage"
                                                        @onchange="@((ChangeEventArgs e) => UpdateMedication(index, nameof(med.Dosage), e.Value?.ToString() ?? string.Empty))"
                                                        placeholder="e.g., 500mg" />
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <!-- Frequency -->
                                            <div class="col-md-4">
                                                <div class="mb-3">
                                                    <label class="form-label">
                                                        Frequency <span class="text-danger">*</span>
                                                    </label>
                                                    <InputText 
                                                        class="form-control form-control-sm"
                                                        value="@med.Frequency"
                                                        @onchange="@((ChangeEventArgs e) => UpdateMedication(index, nameof(med.Frequency), e.Value?.ToString() ?? string.Empty))"
                                                        placeholder="e.g., Twice daily" />
                                                </div>
                                            </div>

                                            <!-- Duration -->
                                            <div class="col-md-4">
                                                <div class="mb-3">
                                                    <label class="form-label">
                                                        Duration (days) <span class="text-danger">*</span>
                                                    </label>
                                                    <InputNumber 
                                                        class="form-control form-control-sm"
                                                        value="@med.Duration"
                                                        @onchange="@((ChangeEventArgs e) => UpdateMedicationDuration(index, e.Value))" />
                                                </div>
                                            </div>

                                            <!-- Instructions -->
                                            <div class="col-md-4">
                                                <div class="mb-3">
                                                    <label class="form-label">Instructions</label>
                                                    <InputText 
                                                        class="form-control form-control-sm"
                                                        value="@med.Instructions"
                                                        @onchange="@((ChangeEventArgs e) => UpdateMedication(index, nameof(med.Instructions), e.Value?.ToString() ?? string.Empty))"
                                                        placeholder="e.g., After meals" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <button type="button" class="btn btn-sm btn-outline-success" @onclick="AddMedication">
                                <i class="bi bi-plus-circle"></i> Add Another Medication
                            </button>
                        </div>
                    </div>

                    <!-- Form Actions -->
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-success btn-lg" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-circle"></i>
                                <span>Save Consultation</span>
                            }
                        </button>
                        <button type="button" class="btn btn-secondary btn-lg" @onclick="GoBack" disabled="@isSubmitting">
                            <i class="bi bi-arrow-left"></i> Cancel
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int AppointmentId { get; set; }

    private AppointmentModel? appointment;
    private PatientModel? patient;
    private ConsultationCreateModel consultation = new();
    private List<MedicationCreateModel> medications = new();
    
    private string? errorMessage;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private EditContext? editContext;

    protected override async Task OnInitializedAsync()
    {
        await LoadAppointment();
        medications.Add(new MedicationCreateModel());
    }

    protected override void OnParametersSet()
    {
        if (editContext == null && consultation != null)
        {
            editContext = new EditContext(consultation);
        }
    }

    private async Task LoadAppointment()
    {
        try
        {
            isLoading = true;
            appointment = await Http.GetFromJsonAsync<AppointmentModel>($"/api/appointments/{AppointmentId}");
            
            if (appointment == null)
            {
                errorMessage = "Appointment not found.";
            }
            else
            {
                // Load patient details
                patient = await PatientApiClient.GetByIdAsync(appointment.PatientId);
                if (patient == null)
                {
                    errorMessage = "Patient not found.";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading appointment: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        if (isSubmitting || appointment == null || editContext == null)
            return;

        try
        {
            errorMessage = null;
            isSubmitting = true;

            // Prepare consultation with non-empty medications
            var medicationsToSave = medications.Where(m => !string.IsNullOrWhiteSpace(m.Name)).ToList();
            
            if (medicationsToSave.Count == 0)
            {
                errorMessage = "Please add at least one medication with a name.";
                return;
            }

            // Create the consultation with medications
            var consultationPayload = new
            {
                AppointmentId = AppointmentId,
                consultation.Temperature,
                consultation.BloodPressure,
                consultation.Pulse,
                consultation.Complaints,
                consultation.Diagnosis,
                Medications = medicationsToSave
            };

            var response = await Http.PostAsJsonAsync("/api/consultations", consultationPayload);

            if (response.IsSuccessStatusCode)
            {
                // Parse the response to get the prescription ID
                var content = await response.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<JsonElement>(content, 
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                
                if (result.ValueKind != JsonValueKind.Undefined && result.TryGetProperty("prescriptionId", out var prescriptionIdElement))
                {
                    var prescriptionId = prescriptionIdElement.GetInt32();
                    Navigation.NavigateTo($"/prescription/{prescriptionId}");
                }
                else if (result.ValueKind != JsonValueKind.Undefined && result.TryGetProperty("id", out var idElement))
                {
                    // Alternative property name for the ID
                    var consultationId = idElement.GetInt32();
                    errorMessage = "Consultation saved successfully!";
                    await Task.Delay(1000);
                    Navigation.NavigateTo("/appointments");
                }
                else
                {
                    errorMessage = "Consultation saved but could not retrieve confirmation.";
                }
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error saving consultation: {response.StatusCode} - {content}";
                Console.WriteLine($"API Error: {errorMessage}");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            Console.WriteLine($"Exception: {ex}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void HandleInvalidSubmit()
    {
        errorMessage = "Please fix the validation errors above before submitting.";
    }

    private void AddMedication()
    {
        medications.Add(new MedicationCreateModel());
    }

    private void UpdateMedication(int index, string propertyName, string value)
    {
        if (index >= 0 && index < medications.Count)
        {
            var medication = medications[index];
            switch (propertyName)
            {
                case nameof(MedicationCreateModel.Name):
                    medication.Name = value;
                    break;
                case nameof(MedicationCreateModel.Dosage):
                    medication.Dosage = value;
                    break;
                case nameof(MedicationCreateModel.Frequency):
                    medication.Frequency = value;
                    break;
                case nameof(MedicationCreateModel.Instructions):
                    medication.Instructions = value;
                    break;
            }
            medications[index] = medication;
            StateHasChanged();
        }
    }

    private void UpdateMedicationDuration(int index, object? value)
    {
        if (index >= 0 && index < medications.Count && value != null)
        {
            if (int.TryParse(value.ToString(), out int duration))
            {
                medications[index].Duration = duration;
                StateHasChanged();
            }
        }
    }

    private void RemoveMedication(int index)
    {
        if (medications.Count > 1)
        {
            medications.RemoveAt(index);
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/appointments");
    }
}
